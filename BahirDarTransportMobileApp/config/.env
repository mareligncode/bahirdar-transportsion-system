# Mobile app backend URL - Use your actual backend server IP/domain
# For development, use your local IP (replace with your actual IP)
# For production, use your deployed server URL

# Development (Local Network) - Use your machine's IP address
#  EXPO_PUBLIC_API_URL=http://10.161.152.30:5000/api
  EXPO_PUBLIC_API_URL=http://192.168.137.1:5000/api

# Alternative: Use localhost for emulator/simulator testing
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Alternative: Use ngrok for testing (replace with your actual ngrok URL)
# EXPO_PUBLIC_API_URL=https://your-ngrok-subdomain.ngrok-free.app/api

# App Configuration
EXPO_PUBLIC_APP_NAME=BahirDar Transport
EXPO_PUBLIC_APP_VERSION=1.0.0

# Chapa Payment (Add later)
# EXPO_PUBLIC_CHAPA_PUBLIC_KEY=your_chapa_public_key
# EXPO_PUBLIC_CHAPA_BASE_URL=https://api.chapa.co/v1

# Google Maps (for tracking)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Feature Flags
# EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
# EXPO_PUBLIC_ENABLE_ANALYTICS=true
